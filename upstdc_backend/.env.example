# Copy to .env and fill with secure values. Do NOT commit real secrets.

# MongoDB configuration
MONGO_URI=mongodb://username:password@localhost:27017/?authSource=admin
MONGO_DB=upstdc

# Auth configuration
JWT_SECRET=replace-with-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS - comma separated list, e.g. "http://localhost:3000,https://example.com"
CORS_ALLOWED_ORIGINS=http://localhost:3000
