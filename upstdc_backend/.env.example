# Application
APP_NAME=UPSTDC Backend API
APP_VERSION=0.1.0

# CORS (comma-separated origins; use "*" for all)
CORS_ALLOWED_ORIGINS=*

# Database (Optional at startup)
# The backend can start without DB. DB-dependent APIs will return 503 until configured.
# MONGO_URI=mongodb://user:password@host:27017
# MONGO_DB=upstdc

# Auth (Optional at startup, required for protected/auth routes)
# The backend can start without JWT_SECRET. Auth features will not work until set.
# Do NOT log this value; keep it secret.
# JWT_SECRET=change_me
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
